NEXT_PUBLIC_SUPABASE_URL=https://bpobtbiuyfmqziidvgnm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Brave Web Search key; use a plan permitting result storage.
BRAVE_SEARCH_API_KEY=

# Required for tldraw in production; obtain a license from tldraw.
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Morning email and background scout (Vercel Cron). Server-only.
# Supabase → Project Settings → API keys → secret key. Never expose it to the browser.
SUPABASE_SECRET_KEY=
# Any long random string; Vercel sends it to the cron route automatically.
CRON_SECRET=
# resend.com → API Keys. Without a verified domain, mail can only go to your Resend account's address.
RESEND_API_KEY=
# Optional once a domain is verified in Resend, e.g. "DWS Research <studio@yourdomain.com>".
DIGEST_FROM=
